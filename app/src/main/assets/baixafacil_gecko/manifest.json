{
  "manifest_version": 2,
  "name": "Baixa Fácil - integração local de mídia",
  "version": "1.0.0",
  "browser_specific_settings": {"gecko": {"id": "gecko.bridge@baixafacil.local"}},
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["media.js"], "run_at": "document_idle", "all_frames": false}]
}
